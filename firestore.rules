rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "VXDMuU17gifoBqTkbpC55Xre9242";
    }

    function ownsDocument() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    function membershipPath(uid) {
      return /databases/$(database)/documents/membership_status/$(uid);
    }

    // A user without a membership_status document is treated as active.
    function memberStatus(uid) {
      return exists(membershipPath(uid))
        ? get(membershipPath(uid)).data.status
        : "active";
    }

    function canView() {
      return signedIn()
        && (
          isAdmin()
          || memberStatus(request.auth.uid) in ["active", "restricted"]
        );
    }

    function canInteract() {
      return signedIn()
        && (
          isAdmin()
          || memberStatus(request.auth.uid) == "active"
        );
    }

    // MEMBERSHIP STATUS: members can read only their own status;
    // the administrator can read all statuses and change them.
    match /membership_status/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAdmin()
        || (
          canInteract()
          && request.auth.uid == userId
        );

      allow delete: if isAdmin();

      // USER NOTIFICATIONS
      match /notifications/{notificationId} {
        allow read: if signedIn()
          && request.auth.uid == userId
          && canView();

        allow create: if canInteract()
          && request.resource.data.actorUid == request.auth.uid
          && request.auth.uid != userId
          && request.resource.data.type in ["like", "comment"]
          && request.resource.data.postId is string
          && get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.uid == userId;

        allow update: if signedIn()
          && request.auth.uid == userId
          && canView()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;

        allow delete: if signedIn()
          && (request.auth.uid == userId || isAdmin());
      }
    }

    // POSTS
    match /posts/{postId} {
      allow read: if canView();

      allow create: if canInteract()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 220;

      allow update, delete: if isAdmin()
        || (canInteract() && ownsDocument());

      // POST LIKES
      match /likes/{userId} {
        allow read: if canView();

        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow delete: if canInteract()
          && request.auth.uid == userId;
      }

      // POST COMMENTS
      match /comments/{commentId} {
        allow read: if canView();

        allow create: if canInteract()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow delete: if isAdmin()
          || (
            canInteract()
            && resource.data.uid == request.auth.uid
          );

        allow update: if false;
      }
    }

    // STORIES
    match /stories/{storyId} {
      allow read: if canView();

      allow create: if canInteract()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow delete: if isAdmin()
        || (canInteract() && ownsDocument());

      allow update: if false;

      // STORY VIEWS
      match /views/{userId} {
        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow read: if canView()
          && (
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data.uid == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }

      // STORY REACTIONS
      match /reactions/{userId} {
        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string;

        allow read: if canView()
          && (
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data.uid == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }
    }
  }
}
