rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'VXDMuU17gifoBqTkbpC55Xre9242';
    }

    function statusPath(uid) {
      return /databases/$(database)/documents/membership_status/$(uid);
    }

    function canAccess(uid) {
      return !exists(statusPath(uid))
        || get(statusPath(uid)).data.status in ['active', 'restricted'];
    }

    function canPost(uid) {
      return !exists(statusPath(uid))
        || get(statusPath(uid)).data.status == 'active';
    }

    // POSTS
    match /posts/{postId} {

      allow read: if signedIn()
        && (isAdmin() || canAccess(request.auth.uid));

      allow create: if signedIn()
        && canPost(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 220;

      allow update, delete: if isAdmin()
        || (signedIn()
        && canPost(request.auth.uid)
        && resource.data.uid == request.auth.uid);

      // LIKES
      match /likes/{userId} {

        allow read: if signedIn()
          && (isAdmin() || canAccess(request.auth.uid));

        allow create: if signedIn()
          && canPost(request.auth.uid)
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));

        allow delete: if signedIn()
          && request.auth.uid == userId
          && resource.data.uid == request.auth.uid
          && canAccess(request.auth.uid);

        allow update: if false;
      }

      // COMMENTS
      match /comments/{commentId} {

        allow read: if signedIn()
          && (isAdmin() || canAccess(request.auth.uid));

        allow create: if signedIn()
          && canPost(request.auth.uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId));

        allow delete: if isAdmin()
          || (signedIn()
          && canAccess(request.auth.uid)
          && resource.data.uid == request.auth.uid);

        allow update: if false;
      }
    }

    // STORIES
    match /stories/{storyId} {

      allow read: if signedIn()
        && (isAdmin() || canAccess(request.auth.uid));

      allow create: if signedIn()
        && canPost(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.photoURL is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(24, 'h');

      allow delete: if isAdmin()
        || (signedIn()
        && canAccess(request.auth.uid)
        && resource.data.uid == request.auth.uid);

      allow update: if false;

      // STORY VIEWS
      match /views/{viewerId} {

        allow read: if signedIn()
          && (
            isAdmin()
            || get(/databases/$(database)/documents/stories/$(storyId)).data.uid
              == request.auth.uid
          );

        allow create: if signedIn()
          && canAccess(request.auth.uid)
          && request.auth.uid == viewerId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.uid
            != request.auth.uid;

        allow update: if false;

        allow delete: if isAdmin()
          || (signedIn() && request.auth.uid == viewerId);
      }

      // STORY REACTIONS
      match /reactions/{reactorId} {

        allow read: if signedIn()
          && (isAdmin() || canAccess(request.auth.uid));

        allow create, update: if signedIn()
          && canPost(request.auth.uid)
          && request.auth.uid == reactorId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji == '❤️'
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/stories/$(storyId)).data.uid
            != request.auth.uid;

        allow delete: if signedIn()
          && request.auth.uid == reactorId;
      }
    }

    // USERS AND NOTIFICATIONS
    match /users/{userId} {

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin();

      // NOTIFICATIONS
      match /notifications/{notificationId} {

        allow read: if signedIn()
          && request.auth.uid == userId;

        allow create: if signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorUid != userId
          && request.resource.data.actorName is string
          && request.resource.data.postId is string
          && request.resource.data.type in ['like', 'comment']
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && exists(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          )
          && get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.uid == userId
          && (
            request.resource.data.type != 'comment'
            || (
              request.resource.data.commentText is string
              && request.resource.data.commentText.size() <= 500
            )
          );

        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;

        allow delete: if signedIn()
          && request.auth.uid == userId;
      }
    }

    // MEMBERSHIP
    match /membership_status/{userId} {

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create, update, delete: if isAdmin();
    }
  }
}
