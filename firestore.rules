rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "VXDMuU17gifoBqTkbpC55Xre9242";
    }

    function membershipPath(uid) {
      return /databases/$(database)/documents/membership_status/$(uid);
    }

    function memberStatus(uid) {
      return exists(membershipPath(uid))
        ? get(membershipPath(uid)).data.status
        : "active";
    }

    function canView() {
      return signedIn()
        && (
          isAdmin()
          || memberStatus(request.auth.uid) in ["active", "restricted"]
        );
    }

    function canInteract() {
      return signedIn()
        && (
          isAdmin()
          || memberStatus(request.auth.uid) == "active"
        );
    }

    function ownsDocument() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // FOLLOW RELATIONSHIP HELPERS

    function followingPath(followerId, targetId) {
      return /databases/$(database)/documents/users/$(followerId)/following/$(targetId);
    }

    function followersPath(targetId, followerId) {
      return /databases/$(database)/documents/users/$(targetId)/followers/$(followerId);
    }

    match /membership_status/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {

      allow read: if canView()
        && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      allow update: if isAdmin()
        || (
          canInteract()
          && request.auth.uid == userId
        );

      allow delete: if isAdmin();

      // FOLLOWERS
      match /followers/{followerId} {

        allow read: if canView();

        allow create: if canInteract()
          && request.auth.uid == followerId
          && followerId != userId
          && request.resource.data.uid == followerId
          && request.resource.data.followedUid == userId
          && existsAfter(followingPath(followerId, userId));

        allow delete: if canInteract()
          && request.auth.uid == followerId
          && exists(followersPath(userId, followerId))
          && !existsAfter(followingPath(followerId, userId));

        allow update: if false;
      }

      // FOLLOWING
      match /following/{followingId} {

        allow read: if canView();

        allow create: if canInteract()
          && request.auth.uid == userId
          && followingId != userId
          && request.resource.data.uid == userId
          && request.resource.data.followedUid == followingId
          && existsAfter(followersPath(followingId, userId));

        allow delete: if canInteract()
          && request.auth.uid == userId
          && !existsAfter(followersPath(followingId, userId));

        allow update: if false;
      }

      // NOTIFICATIONS
      match /notifications/{notificationId} {

        allow read: if signedIn()
          && request.auth.uid == userId
          && canView();

        allow create: if canInteract()
          && request.resource.data.actorUid == request.auth.uid
          && request.auth.uid != userId
          && request.resource.data.type in [
            "like", "comment", "follow"
          ]
          && request.resource.data.actorName is string
          && request.resource.data.read == false
          && request.resource.data.createdAt is timestamp
          && (
            request.resource.data.type == "follow"
            ||
            (
              request.resource.data.postId is string
              && get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.uid == userId
            )
          );

        allow update: if signedIn()
          && request.auth.uid == userId
          && canView()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;

        allow delete: if signedIn()
          && (request.auth.uid == userId || isAdmin());
      }
    }

    // POSTS
    match /posts/{postId} {

      allow read: if canView();

      allow create: if canInteract()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 220;

      allow update, delete: if isAdmin()
        || (canInteract() && ownsDocument());

      match /likes/{userId} {

        allow read: if canView();

        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow delete: if canInteract()
          && request.auth.uid == userId;
      }

      match /comments/{commentId} {

        allow read: if canView();

        allow create: if canInteract()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow delete: if isAdmin()
          || (
            canInteract()
            && resource.data.uid == request.auth.uid
          );

        allow update: if false;
      }
    }

    // STORIES
    match /stories/{storyId} {

      allow read: if canView();

      allow create: if canInteract()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      allow delete: if isAdmin()
        || (canInteract() && ownsDocument());

      allow update: if false;

      match /views/{userId} {

        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow read: if canView()
          && (
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data.uid == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }

      match /reactions/{userId} {

        allow create, update: if canInteract()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string;

        allow read: if canView()
          && (
            get(
              /databases/$(database)/documents/stories/$(storyId)
            ).data.uid == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }
    }
  }
}
