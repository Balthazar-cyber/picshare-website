rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "VXDMuU17gifoBqTkbpC55Xre9242";
    }

    function ownsDocument() {
      return signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // -------------------------
    // PICSHARE POSTS
    // -------------------------
    match /posts/{postId} {

      // Signed-in members can view posts.
      allow read: if signedIn();

      // Members can create posts under their own UID.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 220;

      // Members can edit or delete their own posts.
      allow update, delete: if ownsDocument() || isAdmin();
    }

    // -------------------------
    // PICSHARE STORIES
    // -------------------------
    match /stories/{storyId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp;

      // Only the story owner or admin can delete a story.
      allow delete: if ownsDocument() || isAdmin();

      // Story details cannot be edited directly.
      allow update: if false;

      // -------------------------
      // STORY VIEWS
      // -------------------------
      match /views/{userId} {

        // A member can record their own view.
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        // Only the story owner or admin can see viewers.
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.uid
              == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }

      // -------------------------
      // STORY REACTIONS
      // -------------------------
      match /reactions/{userId} {

        // A member can react using their own UID.
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string;

        // Only the story owner or admin can see reactions.
        allow read: if signedIn()
          && (
            get(/databases/$(database)/documents/stories/$(storyId)).data.uid
              == request.auth.uid
            || isAdmin()
          );

        allow delete: if false;
      }
    }
  }
}
